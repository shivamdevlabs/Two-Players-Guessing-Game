# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# MongoDB Connection (Falls back to in-memory mock if server is not reachable)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=two_player_guessing_game

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Game Configuration
MIN_NUMBER=1
MAX_NUMBER=100
DEFAULT_TIME_LIMIT_SECONDS=300
RECONNECT_GRACE_PERIOD_SECONDS=60
