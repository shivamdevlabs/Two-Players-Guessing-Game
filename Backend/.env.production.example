# Backend Production Environment Configuration
# Set these environment variables in Render / Railway / Fly.io dashboard:

# MongoDB Atlas connection string (replace <username>, <password>, <cluster> with yours)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=two_player_guessing_game

# Secret key for player session tokens (generate a strong random string)
SECRET_KEY=generate_a_random_32_character_secret_here

# Network host & port (cloud hosts like Render/Railway automatically inject PORT)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Game parameters
MIN_NUMBER=1
MAX_NUMBER=100
DEFAULT_TIME_LIMIT_SECONDS=300
RECONNECT_GRACE_PERIOD_SECONDS=60
